{
  "name": "@burak/asset-library",
  "version": "0.1.0",
  "description": "Zero-GC procedural low-poly asset library for Three.js games",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/asset-library.umd.cjs",
  "module": "./dist/asset-library.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asset-library.js",
      "require": "./dist/asset-library.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "verify": "node --expose-gc scripts/verify.mjs",
    "preview": "vite preview"
  },
  "keywords": [
    "threejs",
    "procedural",
    "low-poly",
    "game-assets",
    "zero-gc",
    "webgl"
  ],
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.169.0",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0"
  }
}
